# ------------------------------------------------------------------
# Firebase configuration (Authentication)
# ------------------------------------------------------------------
# The app currently uses a STUB auth service so the dashboard can be
# reviewed without a Firebase project. To enable real Firebase auth:
#   1. Create a project at https://console.firebase.google.com
#   2. Enable Authentication -> Sign-in method -> Email/Password
#   3. Copy your web app config values below (rename this file to ".env")
#   4. Implement `FirebaseAuthService` in src/auth/FirebaseAuthService.ts
#      (mirrors the StubAuthService interface) and swap it in src/index.ts
# ------------------------------------------------------------------
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# Bypass the auth gate entirely (stub demo mode). Set to "false" once
# real Firebase auth is wired up.
AUTH_STUB=true

# Refresh interval for system polling, in milliseconds
REFRESH_INTERVAL=1000
